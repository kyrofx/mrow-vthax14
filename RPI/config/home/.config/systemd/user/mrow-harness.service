[Unit]
Description=MROW DJ harness (play history, crowd ratings, suggestions)
Documentation=file:%h/mrow/harness/README.md
After=default.target

[Service]
Type=simple
# Localhost only: the panel in BiteDJ is the client, and this prototype has no
# authentication.
ExecStart=/usr/bin/python3 %h/.local/share/mrow/harness/src/harness.py --host 127.0.0.1 --port 8765
# The cloud model's endpoint and key, when one is configured (mode 600).
EnvironmentFile=-%h/.config/mrow/harness.env
Restart=always
RestartSec=2
# Ranking and SQLite must never compete with the audio engine, which runs at
# real-time priority pinned to the CPUs.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
