<!DOCTYPE template>
<!--
  The stem buttons, shown in place of a deck's overview waveform while its S
  button is on (see deck.xml). Two stems: vocals and instrumental.

  Variables:
    channel: the deck number.
-->
<Template>
  <WidgetGroup>
    <ObjectName>StemPanel</ObjectName>
    <Layout>horizontal</Layout>
    <Size>0me,50f</Size>
    <Connection>
      <ConfigKey>[Skin],stem_panel_<Variable name="channel"/></ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
    <Connection>
      <ConfigKey>[Channel<Variable name="channel"/>],stem_available</ConfigKey>
      <BindProperty>enabled</BindProperty>
    </Connection>
    <Children>

      <PushButton>
        <ObjectName>StemButton</ObjectName>
        <SizePolicy>me,me</SizePolicy>
        <NumberStates>2</NumberStates>
        <State>
          <Number>0</Number>
          <Text>VOCALS</Text>
        </State>
        <State>
          <Number>1</Number>
          <Text>VOCALS</Text>
        </State>
        <Connection>
          <ConfigKey>[Channel<Variable name="channel"/>],stem_vocals_enabled</ConfigKey>
          <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
      </PushButton>

      <PushButton>
        <ObjectName>StemButton</ObjectName>
        <SizePolicy>me,me</SizePolicy>
        <NumberStates>2</NumberStates>
        <State>
          <Number>0</Number>
          <Text>INSTRUMENTAL</Text>
        </State>
        <State>
          <Number>1</Number>
          <Text>INSTRUMENTAL</Text>
        </State>
        <Connection>
          <ConfigKey>[Channel<Variable name="channel"/>],stem_instrumental_enabled</ConfigKey>
          <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
      </PushButton>

    </Children>
  </WidgetGroup>
</Template>
