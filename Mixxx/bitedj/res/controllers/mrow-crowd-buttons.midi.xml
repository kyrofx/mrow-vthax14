<?xml version="1.0" encoding="utf-8"?>
<MixxxControllerPreset mixxxVersion="2.3.0+" schemaVersion="1">
  <info>
    <!-- The name must contain the virtual port name the mrow-buttons daemon
         opens (RPI/src/buttons): the fork pairs a MIDI device with the mapping
         whose name contains the device's. -->
    <name>MROW Crowd Buttons</name>
    <author>MROW</author>
    <description>Pi switches: Load 1, Load 2, Good, Med, Bad. Qwiic Twist: FLX4 browse rotation and pushbutton.</description>
    <!-- Built into the unit: applied automatically, never shown in the Devices picker. -->
    <hidden>true</hidden>
  </info>
  <controller id="MROW:crowd-buttons">
    <scriptfiles>
      <file filename="mrow-controls.js" functionprefix="MROWControls"/>
    </scriptfiles>
    <controls>
      <control>
        <group>[Channel1]</group><key>LoadSelectedTrack</key>
        <status>0x90</status><midino>0x40</midino>
        <options><Normal/></options>
      </control>
      <control>
        <group>[Channel2]</group><key>LoadSelectedTrack</key>
        <status>0x90</status><midino>0x41</midino>
        <options><Normal/></options>
      </control>
      <control>
        <group>[Library]</group><key>MROWControls.browseRotate</key>
        <status>0xB0</status><midino>0x40</midino>
        <options><Script-Binding/></options>
      </control>
      <control>
        <group>[Library]</group><key>MROWControls.browsePress</key>
        <status>0x90</status><midino>0x42</midino>
        <options><Script-Binding/></options>
      </control>
      <!-- The daemon sends note on, velocity 127 on press and velocity 0 on
           release, so each button needs only the 0x90 entry. Channel 1, notes
           as in ~/.config/mrow/buttons.toml. -->
      <control>
        <group>[Harness]</group>
        <key>rate_good</key>
        <status>0x90</status>
        <midino>0x3C</midino>
        <options><Normal/></options>
      </control>
      <control>
        <group>[Harness]</group>
        <key>rate_mid</key>
        <status>0x90</status>
        <midino>0x3D</midino>
        <options><Normal/></options>
      </control>
      <control>
        <group>[Harness]</group>
        <key>rate_bad</key>
        <status>0x90</status>
        <midino>0x3E</midino>
        <options><Normal/></options>
      </control>
    </controls>
    <outputs/>
  </controller>
</MixxxControllerPreset>
